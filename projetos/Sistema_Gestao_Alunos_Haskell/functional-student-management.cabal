cabal-version:      2.4
name:               functional-student-management
version:            0.1.0.0
build-type:         Simple

executable student-manager
  main-is:          Main.hs
  hs-source-dirs:   app, src
  other-modules:    Model, Parsing, Domain, Report
  build-depends:    base >=4.14 && <5
  default-language: Haskell2010
  ghc-options:      -Wall

test-suite student-manager-tests
  type:             exitcode-stdio-1.0
  main-is:          TestMain.hs
  hs-source-dirs:   test, src
  other-modules:    Model, Parsing, Domain
  build-depends:    base >=4.14 && <5
  default-language: Haskell2010
  ghc-options:      -Wall
